# VirusTotal Public API key
VT_API_KEY=put_your_key_here

# Persistent paths INSIDE the container. Mount /data and /logs from host.
DB_PATH=/data/vt_history.sqlite3
LOG_PATH=/logs/app.log

# Keep cached results/comments for 7 days
CACHE_TTL_DAYS=7

# Application-level guard to avoid burning the VT Public API quota
REQUESTS_PER_HOUR=20

# Max rows displayed in public history
MAX_HISTORY=1000
